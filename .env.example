DATABASE_URL=postgres://ledgerguard:change-me@localhost:5432/ledgerguard
POSTGRES_PASSWORD=change-me
# Direct binary runs bind to loopback by default. Compose overrides this inside the container.
LEDGERGUARD_BIND_ADDR=127.0.0.1:8080
RUST_LOG=ledgerguard=debug,tower_http=info

# Provider selection. SaldeoSMART is the default when omitted.
LEDGERGUARD_ACCOUNTING_PROVIDER=saldeo

# SaldeoSMART
# SALDEO_USERNAME=
# SALDEO_API_TOKEN=

# Fakturownia / InvoiceOcean
# FAKTUROWNIA_ACCOUNT_DOMAIN=twoja-domena.fakturownia.pl
# FAKTUROWNIA_API_TOKEN=

# inFakt API v3
# INFAKT_API_KEY=

# wFirma API keys. OAuth2 can be added behind the same adapter later.
# WFIRMA_ACCESS_KEY=
# WFIRMA_SECRET_KEY=
# WFIRMA_APP_KEY=
