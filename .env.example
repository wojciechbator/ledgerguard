# Local/development example only. Never commit the real .env file.
# Use long, unique, URL-safe random values in production.
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgres://ledgerguard:replace-with-long-random-password@localhost:5432/ledgerguard

# Direct binary runs bind to loopback by default. Compose overrides this inside the app container.
LEDGERGUARD_BIND_ADDR=127.0.0.1:8080
LEDGERGUARD_PORT=8088
RUST_LOG=ledgerguard=info,tower_http=info

# All /v1/* endpoints require this bearer token unless auth is explicitly disabled.
LEDGERGUARD_API_TOKEN=replace-with-at-least-32-random-bytes
LEDGERGUARD_AUTH_DISABLED=false

# Second independent safety switch. Keep false until the selected provider contract is live-verified.
LEDGERGUARD_LIVE_SYNC_ENABLED=false

# Planning policy: monthly cost ceiling powers the "can I afford it" verdicts
# on the dashboard and /v1/planner/affordability. Empty = summary only.
# LEDGERGUARD_MONTHLY_COST_BUDGET=12000.00
# LEDGERGUARD_TIGHT_SHARE_BASIS_POINTS=1000

# Provider selection. SaldeoSMART is the default when omitted.
LEDGERGUARD_ACCOUNTING_PROVIDER=saldeo

# SaldeoSMART — first live provider.
SALDEO_BASE_URL=https://saldeo.brainshare.pl
# SALDEO_USERNAME=
# SALDEO_API_TOKEN=
# Filled only after company.list confirms the dedicated user's exact company scope.
# SALDEO_COMPANY_PROGRAM_ID=

# Fakturownia / InvoiceOcean
# FAKTUROWNIA_ACCOUNT_DOMAIN=twoja-domena.fakturownia.pl
# FAKTUROWNIA_DEPARTMENT_ID=
# FAKTUROWNIA_API_TOKEN=

# inFakt API v3
# INFAKT_API_KEY=

# wFirma API keys. Explicit company_id prevents accidental cross-company reads.
# WFIRMA_ACCESS_KEY=
# WFIRMA_SECRET_KEY=
# WFIRMA_APP_KEY=
# WFIRMA_COMPANY_ID=

# Secret-file variants are supported for sensitive values by app config in hardened deployments:
# e.g. LEDGERGUARD_API_TOKEN_FILE=/run/secrets/ledgerguard_api_token
# and SALDEO_API_TOKEN_FILE=/run/secrets/saldeo_api_token.
